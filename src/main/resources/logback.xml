<configuration>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} pipeline=%X{pipeline:-unknown} eventId=%X{eventId:-none} connector=%X{connector:-none} - %msg%n%ex</pattern>
        </encoder>
    </appender>

    <!-- Reduce Kafka internal logging -->
    <logger name="org.apache.kafka" level="WARN"/>

    <!-- Keep your application logs visible -->
    <logger name="com.issaalsabeh.etl" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>

</configuration>